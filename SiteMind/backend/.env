# ============================================================
# SiteMind — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# ----------------------------------
# Google Gemini API
# ----------------------------------
GEMINI_API_KEY=AQ.Ab8RN6KtR7NUtE1BEbsTVAuk7yxx68aFT6sEocwIVwkOCJSAJw

# Chat model — use gemini-flash-latest
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ----------------------------------
# Backend server
# ----------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ----------------------------------
# Crawler settings
# ----------------------------------
CRAWLER_MAX_PAGES=100
CRAWLER_MAX_DEPTH=5
CRAWLER_CONCURRENCY=5
CRAWLER_TIMEOUT=30

# ----------------------------------
# Chunking settings
# ----------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Max chunks to embed per indexing run (free tier safety valve)
# Gemini free tier limit: 100 items per minute for embed_content.
# Setting to 90 ensures 1 API call stays strictly under the 100 item/min limit.
MAX_CHUNKS_V1=90

# ----------------------------------
# Vector search settings
# ----------------------------------
TOP_K_RESULTS=6

# ----------------------------------
# Qdrant (in-memory for V1)
# ----------------------------------
QDRANT_MODE=local
QDRANT_PATH=./qdrant_storage
